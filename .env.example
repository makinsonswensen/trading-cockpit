# =============================================
#  共生者交易决策系统 - 环境配置示例
# =============================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据需要修改配置
# 3. app.py 中通过 os.environ.get() 读取

# ===== 交易所配置 =====
# 支持的交易所：binance, okx, bybit, gate, kucoin 等（ccxt 支持的所有交易所）
EXCHANGE_ID=binance

# 交易对（注意格式：基础货币/计价货币）
SYMBOL=BTC/USDT

# API 密钥（可选，公开数据不需要密钥）
# EXCHANGE_API_KEY=your_api_key
# EXCHANGE_SECRET=your_secret_key

# ===== 缓存配置 =====
# 信号结果缓存时间（秒）—— 最终计算结果的缓存TTL
# 默认 300 秒（5分钟），过期后触发重新计算
CACHE_TTL=300

# K线缓存基准TTL（秒）—— 按周期独立缓存K线数据，减少交易所请求
# 各周期按基准值缩放：
#   1h  = cache_ttl_sec × 1   (默认 60s)
#   4h  = cache_ttl_sec × 3   (默认 180s)
#   8h  = cache_ttl_sec × 6   (默认 360s)
#   12h = cache_ttl_sec × 10  (默认 600s)
#   1d  = cache_ttl_sec × 20  (默认 1200s)
# 调小 → 数据更新更频繁，但请求更多
# 调大 → 减少请求，但数据延迟更高
cache_ttl_sec=60

# ===== Obsidian 配置 =====
# 你的 Obsidian Vault 根目录路径
# Windows 示例：D:\Obsidian Vault
# macOS 示例：/Users/yourname/Documents/Obsidian Vault
# Linux 示例：/home/yourname/Obsidian Vault
OBSIDIAN_VAULT_PATH=./obsidian-vault

# 交易日记子文件夹名
NOTE_FOLDER=交易日记

# ===== 服务配置 =====
# 服务监听地址
HOST=0.0.0.0

# 服务端口
PORT=5001
