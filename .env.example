# =============================================
#  共生者交易决策系统 - 环境配置示例
# =============================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据需要修改配置
# 3. app.py 中可通过 os.environ.get() 读取

# ===== 交易所配置 =====
# 支持的交易所：binance, okx, bybit, gate, kucoin 等（ccxt 支持的所有交易所）
EXCHANGE_ID=binance

# 交易对（注意格式：基础货币/计价货币）
SYMBOL=BTC/USDT

# API 密钥（可选，公开数据不需要密钥）
# EXCHANGE_API_KEY=your_api_key
# EXCHANGE_SECRET=your_secret_key

# ===== 数据配置 =====
# 缓存时间（秒），默认 5 分钟
CACHE_TTL=300

# ===== Obsidian 配置 =====
# 你的 Obsidian Vault 根目录路径
# Windows 示例：D:\Obsidian Vault
# macOS 示例：/Users/yourname/Documents/Obsidian Vault
# Linux 示例：/home/yourname/Obsidian Vault
OBSIDIAN_VAULT_PATH=./obsidian-vault

# 交易日记子文件夹名
NOTE_FOLDER=交易日记

# ===== 服务配置 =====
# 服务监听地址
HOST=0.0.0.0

# 服务端口
PORT=5001
